# ============================================
# AutoLabel 3D — biến môi trường
# ============================================
# Chép thành .env rồi sửa. KHÔNG commit .env (đã có trong .gitignore).
# Mọi biến đều có giá trị mặc định (src/config.py): không có .env vẫn chạy được bản demo.

# ---- Dữ liệu nuScenes ----
# Thư mục chứa v1.0-*/ samples/ sweeps/ (bản mini hoặc trainval)
NUSCENES_DATAROOT=./v1.0-mini-001
# v1.0-mini | v1.0-trainval
NUSCENES_VERSION=v1.0-mini

# ---- Nơi lưu kết quả ----
# Workspace nhãn của chế độ Ảnh / Video (frame, nhãn, cache detection, correction log)
WORKSPACE_DIR=./data/workspace
# Dự án của end-user (trang Dự án): mỗi dự án một thư mục con
PROJECTS_DIR=./data/projects
# Ngưỡng, mô hình, trọng số QA Agent, lan truyền
AUTOLABEL_CONFIG=./configs/autolabel.yaml
# Tên ghi vào correction log khi duyệt
REVIEWER_NAME=annotator

# ---- Bước 3D ----
# Python của môi trường MMDetection3D (tools3d/setup.ps1); để trống = tự tìm .venv-mm3d trong repo
# MM3D_PYTHON=.venv-mm3d\Scripts\python.exe

# ---- Web ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---- AI Hook Logging (do giảng viên cấp, dùng cho hook commit / push) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- LangSmith (tuỳ chọn): trace QA Agent LangGraph ----
# LANGCHAIN_API_KEY=your-langsmith-key-here
# LANGCHAIN_PROJECT=ai20k-agent
# LANGCHAIN_TRACING_V2=true
