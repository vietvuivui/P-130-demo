# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AutoLabel 3D ----
# Mặc định: nuScenes trainval blob01 (85 scene). Bản mini: ./v1.0-mini-001 + v1.0-mini
# NUSCENES_DATAROOT=./data/nuscenes-trainval
# NUSCENES_VERSION=v1.0-trainval-blob01
# WORKSPACE_DIR=./data/workspace-trainval-yoloe
# Dự án của end-user (trang Dự án): mỗi dự án một thư mục con
# PROJECTS_DIR=./data/projects
# Python của môi trường MMDetection3D cho bước 3D (để trống = tự tìm .venv-mm3d trong repo)
# MM3D_PYTHON=.venv-mm3d\Scripts\python.exe

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
